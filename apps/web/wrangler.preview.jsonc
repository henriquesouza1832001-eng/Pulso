{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Prévia por branch. O nome real vem do workflow: --name pulso-web-<branch>.
	"name": "pulso-web-preview",
	"main": "./preview/worker.js",
	"compatibility_date": "2025-10-08",
	"workers_dev": true,
	"preview_urls": false,
	// Worker -> Worker da mesma conta pelo workers.dev dá "error code: 1042": a API vem por Service Binding.
	"services": [{ "binding": "API", "service": "pulso-api" }],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	}
}
